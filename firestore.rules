rules_version = '2';

// BridgeMUN rules for the NEW Firebase environment (emulator / your own project).
// Never deployed to the previous developer's project.
//
// All forum data is written by the server (Admin SDK bypasses rules) through the engine API.
// Clients only READ, and only forums they hold a seat in. The legacy client-write collections
// (participants, speeches, speakRequests, motions, votes, aiSuggestions, admin_countries) were removed
// together with the inherited UI that wrote them, so the two paths can never diverge.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isMember(forumId) {
      return signedIn() && exists(/databases/$(database)/documents/forums/$(forumId)/members/$(uid()));
    }

    match /forums/{forumId} {
      allow read: if isMember(forumId);
      allow write: if false;

      match /members/{memberUid} {
        allow read: if signedIn() && (memberUid == uid() || isMember(forumId));
        allow write: if false;
      }
      // Member-readable projection of the engine (open-ballot choices hidden).
      match /engine/{docId=**} {
        allow read: if isMember(forumId);
        allow write: if false;
      }
      match /record/{entryId} {
        allow read: if isMember(forumId);
        allow write: if false;
      }
      match /events/{eventId} {
        allow read: if isMember(forumId);
        allow write: if false;
      }
      // Full private engine state and usage counters: server only.
      match /engineState/{docId=**} {
        allow read, write: if false;
      }
      match /usage/{docId} {
        allow read, write: if false;
      }
      // Anything else under a forum is closed by default.
      match /{other=**} {
        allow read, write: if false;
      }
    }

    // "My forums": a user may list their own membership rows across forums.
    match /{path=**}/members/{memberUid} {
      allow read: if signedIn() && resource.data.uid == uid();
    }

    match /joinCodes/{code} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow write: if signedIn() && uid() == userId;
    }
  }
}
