{
  "name": "mun",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:emu": "firebase emulators:exec --only firestore,auth,storage --project demo-bridgemun \"vitest run\"",
    "emulators": "firebase emulators:start --project demo-bridgemun",
    "typecheck": "tsc --noEmit",
    "check:integrations": "tsx scripts/check-integrations.ts",
    "dev:project": "node scripts/with-env.mjs .env.project.local -- next dev",
    "check:project": "node scripts/with-env.mjs .env.project.local -- tsx scripts/check-integrations.ts",
    "firebase:deploy-rules": "firebase deploy --only firestore:rules,firestore:indexes --project bridgemun"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@types/jsrsasign": "^10.5.15",
    "@zoom/videosdk": "^2.3.15",
    "clsx": "^2.1.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.10.0",
    "jsrsasign": "^11.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "firebase-tools": "^13.35.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "22.x"
  }
}
