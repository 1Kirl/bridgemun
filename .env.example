# BridgeMUN environment variables — template only. NEVER put real values in this file.
# Local real-project development: copy the needed lines into .env.local (git-ignored).
# Vercel: Project → Settings → Environment Variables (same names).

# ── Firebase (client, public by design) ─────────────────────────────
# "project" = your real Firebase project, "emulator" = local Emulator Suite (see .env.development)
NEXT_PUBLIC_FIREBASE_MODE=project
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── Firebase (server, SECRET) ───────────────────────────────────────
# Must equal NEXT_PUBLIC_FIREBASE_PROJECT_ID (startup check refuses a mismatch).
FIREBASE_PROJECT_ID=
# Service account JSON downloaded from Firebase console, base64-encoded on one line.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ── Zoom Video SDK (server, SECRET) ─────────────────────────────────
ZOOM_VIDEO_SDK_KEY=
ZOOM_VIDEO_SDK_SECRET=
# Random string (32+ chars) used to derive non-guessable Zoom session names.
ZOOM_SESSION_SECRET=

# ── OpenAI (server, SECRET) — used from Phase 4/5 ───────────────────
OPENAI_API_KEY=

# ── ElevenLabs (server, SECRET) — used from Phase 5 ─────────────────
ELEVENLABS_API_KEY=

# ── Scheduler ───────────────────────────────────────────────────────
# local = in-process (dev/test only) · cloudtasks = Google Cloud Tasks (deployment; see docs/scheduler.md)
SCHEDULER_DRIVER=cloudtasks
APP_BASE_URL=
CLOUD_TASKS_LOCATION=asia-northeast3
CLOUD_TASKS_QUEUE=engine-ticks
CLOUD_TASKS_INVOKER_EMAIL=

# ── Legacy (previous developer) — intentionally NOT supported ────────
# GEMINI_API_KEY, NEXT_PUBLIC_ADMIN_ID, NEXT_PUBLIC_ADMIN_PASSWORD,
# NEXT_PUBLIC_ZOOM_VIDEO_SDK_KEY were removed. Do not re-add them.
