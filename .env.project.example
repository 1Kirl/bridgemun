# Template for .env.project.local — REAL Firebase project "bridgemun" (asia-northeast3).
# Copy to .env.project.local (git-ignored) and fill in. Loaded ONLY by the *:project npm scripts:
#   npm run dev:project            local app against the real Firebase project
#   npm run check:project          read-only connectivity check (prints no secret values)
# Plain `npm run dev` keeps using the emulator.

# ── Firebase web app (Firebase console → Project settings → General → Your apps → SDK setup and configuration → Config)
NEXT_PUBLIC_FIREBASE_MODE=project
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bridgemun
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase server (Admin SDK) — must be the same project
FIREBASE_PROJECT_ID=bridgemun
# base64 of the service-account JSON (Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ── Zoom Video SDK (Video SDK app credentials, NOT a Meeting SDK/OAuth app)
ZOOM_VIDEO_SDK_KEY=
ZOOM_VIDEO_SDK_SECRET=
# any random 32+ char string, e.g. output of: openssl rand -hex 32
ZOOM_SESSION_SECRET=

# ── AI / speech (already verified keys)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
AI_DRIVER=openai
STT_PROVIDER=openai
TTS_PROVIDER=elevenlabs
OPENAI_MODEL_DECISION=gpt-6.1-terra
OPENAI_MODEL_SPEECH=gpt-6.2-sol
OPENAI_MODEL_TRANSCRIBE=gpt-transcribe
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Position materials pinned to new forums (none until real materials are ingested)
POSITION_SET_VERSION=none

# ── Scheduler: local is fine for local real-project testing; deployment uses cloudtasks (docs/scheduler.md)
SCHEDULER_DRIVER=local
APP_BASE_URL=
CLOUD_TASKS_LOCATION=asia-northeast3
CLOUD_TASKS_QUEUE=engine-ticks
CLOUD_TASKS_INVOKER_EMAIL=
