# Committed, contains NO secrets. Loaded by `next dev` only.
# Default local development runs entirely against the Firebase Emulator Suite
# with a "demo-" project id, which the Firebase SDKs can never route to a real project.
#
# To develop against YOUR real Firebase project instead, put the values from
# .env.example into .env.local (it overrides this file and is git-ignored).

NEXT_PUBLIC_FIREBASE_MODE=emulator
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-bridgemun
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-bridgemun.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-bridgemun.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Server side (Admin SDK) must use the same project id; checked at startup.
FIREBASE_PROJECT_ID=demo-bridgemun

# Scheduler used to advance meeting deadlines. "local" = in-process timer, dev/test only.
SCHEDULER_DRIVER=local

# AI behaviour for AI seats. "dummy" = deterministic local test double (NOT OpenAI). "off" = AI seats do nothing.
AI_DRIVER=dummy
